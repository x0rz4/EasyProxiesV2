+// timelineRetentionWindow bounds node_timeline by age. Rows older than this
+// are deleted unconditionally; keepPerNode then only caps nodes that burst
+// within the window. With the hourly caller in app this keeps every cleanup
+// proportional to one interval of inserts instead of scanning the whole table
+// with a window function (which previously held the write lock for a duration
+// that grew linearly with table size).
+const timelineRetentionWindow = 24 * time.Hour
+
+// CleanupTimeline prunes node_timeline: first by age against the retention
+// window (an indexed range delete), then — on the nodes that still exceed the
+// per-node cap within the window — by rank. The second pass reads the small
+// set of offending node IDs instead of ranking the entire table.
 func (s *sqliteStore) CleanupTimeline(ctx context.Context, keepPerNode int) error {
 	if keepPerNode <= 0 {
 		keepPerNode = 20
 	}
+	cutoff := time.Now().UTC().Add(-timelineRetentionWindow).Format(time.RFC3339)
 
-	_, err := s.writeConn().ExecContext(ctx,
-		`DELETE FROM node_timeline WHERE id NOT IN (
-			SELECT id FROM (
-				SELECT id, ROW_NUMBER() OVER (PARTITION BY node_id ORDER BY id DESC) as rn
-				FROM node_timeline
-			) WHERE rn <= ?
-		)`, keepPerNode,
+	if _, err := s.writeConn().ExecContext(ctx,
+		`DELETE FROM node_timeline WHERE created_at < ?`, cutoff,
+	); err != nil {
+		return fmt.Errorf("delete expired timeline rows: %w", err)
+	}
+
+	// Nodes that still hold more than keepPerNode rows inside the window.
+	rows, err := s.readConn().QueryContext(ctx,
+		`SELECT node_id FROM node_timeline GROUP BY node_id HAVING COUNT(*) > ?`,
+		keepPerNode,
 	)
-	return err
+	if err != nil {
+		return fmt.Errorf("find over-cap timeline nodes: %w", err)
+	}
+	var overCap []int64
+	for rows.Next() {
+		var nodeID int64
+		if err := rows.Scan(&nodeID); err != nil {
+			rows.Close()
+			return fmt.Errorf("scan over-cap timeline node: %w", err)
+		}
+		overCap = append(overCap, nodeID)
+	}
+	rows.Close()
+	if err := rows.Err(); err != nil {
+		return fmt.Errorf("iterate over-cap timeline nodes: %w", err)
+	}
+
+	for _, nodeID := range overCap {
+		if _, err := s.writeConn().ExecContext(ctx,
+			`DELETE FROM node_timeline WHERE node_id = ? AND id NOT IN (
+				SELECT id FROM node_timeline WHERE node_id = ? ORDER BY id DESC LIMIT ?
+			)`, nodeID, nodeID, keepPerNode,
+		); err != nil {
+			return fmt.Errorf("trim timeline for node %d: %w", nodeID, err)
+		}
+	}
+	return nil
 }
 
